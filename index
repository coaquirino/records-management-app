<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <meta name="viewport"
        content="width=device-width, initial-scale=1">
  <style>
    body {
      font-family: Arial, sans-serif;
      max-width: 900px;
      margin: 30px auto;
      padding: 0 16px;
      background: #f5f7fa;
    }
    input, select, textarea, button {
      box-sizing: border-box;
      padding: 10px;
      margin: 5px 0;
      width: 100%;
    }
    button {
      cursor: pointer;
      background: #1769aa;
      color: white;
      border: 0;
      border-radius: 5px;
    }
    .panel {
      background: white;
      padding: 18px;
      border-radius: 8px;
      margin-bottom: 16px;
    }
    .table-wrap { overflow-x: auto; }
    table {
      width: 100%;
      border-collapse: collapse;
      background: white;
    }
    th, td {
      padding: 10px;
      border-bottom: 1px solid #ddd;
      text-align: left;
    }
    #message { white-space: pre-wrap; }
  </style>
</head>
<body>
  <h2>Records Management App</h2>

  <div class="panel">
    <h3>Add a record</h3>
    <form id="recordForm">
      <label>Date</label>
      <input name="date" type="date">

      <label>Document number *</label>
      <input name="documentNo" required>

      <label>Title *</label>
      <input name="title" required>

      <label>Office</label>
      <input name="office">

      <label>Status</label>
      <select name="status">
        <option>Pending</option>
        <option>In Progress</option>
        <option>Completed</option>
      </select>

      <label>Remarks</label>
      <textarea name="remarks"></textarea>

      <button type="submit">Save Record</button>
    </form>
    <p id="message" role="status"></p>
  </div>

  <div class="panel">
    <h3>Saved records</h3>
    <input id="search"
           placeholder="Search document number or title">
    <button type="button" onclick="loadRecords()">
      Refresh Records
    </button>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Date</th>
            <th>Document No.</th>
            <th>Title</th>
            <th>Office</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody id="records"></tbody>
      </table>
    </div>
  </div>

  <script>
    const form = document.getElementById('recordForm');
    const message = document.getElementById('message');
    let allRecords = [];

    form.addEventListener('submit', function(event) {
      event.preventDefault();
      const data = Object.fromEntries(
        new FormData(form).entries()
      );

      message.textContent = 'Saving...';

      google.script.run
        .withSuccessHandler(function() {
          message.textContent = 'Record saved successfully.';
          form.reset();
          loadRecords();
        })
        .withFailureHandler(function(error) {
          message.textContent = 'Error: ' + error.message;
        })
        .addRecord(data);
    });

    function loadRecords() {
      message.textContent = 'Loading records...';

      google.script.run
        .withSuccessHandler(function(records) {
          allRecords = records;
          renderRecords();
          message.textContent = '';
        })
        .withFailureHandler(function(error) {
          message.textContent = 'Error: ' + error.message;
        })
        .getRecords();
    }

    function renderRecords() {
      const query = document.getElementById('search')
        .value.toLowerCase();

      const filtered = allRecords.filter(function(r) {
        return (r.documentNo + ' ' + r.title)
          .toLowerCase().includes(query);
      });

      const tbody = document.getElementById('records');
      tbody.replaceChildren();

      filtered.forEach(function(r) {
        const tr = document.createElement('tr');

        [r.date, r.documentNo, r.title,
         r.office, r.status].forEach(function(value) {
          const td = document.createElement('td');
          td.textContent = value || '';
          tr.appendChild(td);
        });

        tbody.appendChild(tr);
      });
    }

    document.getElementById('search')
      .addEventListener('input', renderRecords);

    loadRecords();
  </script>
</body>
</html>
